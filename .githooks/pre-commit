#!/usr/bin/env bash
# .githooks/pre-commit
# Blocks commits that expose restricted identifiers.
# Activate: git config core.hooksPath .githooks
#
# Identity resolution order (mirrors git's own):
#   1. git config user.name / user.email
#   2. GIT_AUTHOR_NAME / GIT_AUTHOR_EMAIL        (env override)
#   3. GIT_COMMITTER_NAME / GIT_COMMITTER_EMAIL  (env override)
#   4. OS fallback: USERNAME / USERDOMAIN / COMPUTERNAME / hostname
#      (only checked when git config is unset — that is when git
#       would actually use OS identity)
#   5. Staged file content (full blob via git show; .githooks/ excluded)

set -euo pipefail

# ── Blocked patterns (encoded; categories: BLOCKED_NAME_1, BLOCKED_NAME_2) ─
_E1="RnJlZCBNYW5kYXB8RnJlZGVyaWNrIE1hbmRhcA=="
# ── (categories: BLOCKED_EMAIL, BLOCKED_ORG_DOMAIN, BLOCKED_ORG, BLOCKED_HANDLE)
_E2="ZnJlZGVyaWNrXC5tYW5kYXB8YWNjZW50dXJlXC5jb218QWNjZW50dXJlfHRodWdfa2NpcmVkZXJm"

_dec() { printf '%s' "$1" | base64 -d 2>/dev/null || printf '%s' "$1" | base64 -D 2>/dev/null || true; }
P1=$(_dec "$_E1"); P2=$(_dec "$_E2")
_C="${P1}|${P2}"
[[ -n "$P1" && -n "$P2" ]] || { printf '[pre-commit] WARNING: pattern decode failed — check skipped.\n' >&2; exit 0; }

FAIL=0

_blk() {
  local lbl="$1" val="$2"
  [[ -z "$val" ]] && return 0
  if printf '%s' "$val" | grep -qiE "$_C"; then
    printf '[pre-commit] BLOCKED (%s): restricted identifier detected.\n' "$lbl" >&2
    FAIL=1
  fi
}

# ── 1. git config ──────────────────────────────────────────────────────────
_GIT_NAME="$(git config user.name  2>/dev/null || true)"
_GIT_EMAIL="$(git config user.email 2>/dev/null || true)"
_blk "user.name"  "$_GIT_NAME"
_blk "user.email" "$_GIT_EMAIL"

# ── 2. GIT_AUTHOR_* ────────────────────────────────────────────────────────
_blk "GIT_AUTHOR_NAME"  "${GIT_AUTHOR_NAME:-}"
_blk "GIT_AUTHOR_EMAIL" "${GIT_AUTHOR_EMAIL:-}"

# ── 3. GIT_COMMITTER_* ─────────────────────────────────────────────────────
_blk "GIT_COMMITTER_NAME"  "${GIT_COMMITTER_NAME:-}"
_blk "GIT_COMMITTER_EMAIL" "${GIT_COMMITTER_EMAIL:-}"

# ── 4. OS fallback — only when git config is entirely unset ────────────────
if [[ -z "$_GIT_NAME" || -z "$_GIT_EMAIL" ]]; then
  _blk "OS username" "${USERNAME:-$(whoami 2>/dev/null || true)}"
  _blk "OS domain"   "${USERDOMAIN:-}"
  _blk "OS host"     "${COMPUTERNAME:-$(hostname 2>/dev/null || true)}"
fi

# ── 5. Staged file content ─────────────────────────────────────────────────
while IFS= read -r _f; do
  [[ -z "$_f" ]]           && continue
  [[ "$_f" == .githooks/* ]] && continue
  if git show ":${_f}" 2>/dev/null | grep -qiE "$_C"; then
    printf '[pre-commit] BLOCKED (%s): staged content contains a restricted identifier.\n' "$_f" >&2
    FAIL=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)

if [[ $FAIL -ne 0 ]]; then
  printf '\nCommit blocked. Remove or redact restricted content and retry.\n' >&2
  printf '  git config user.name  "Developer"\n' >&2
  printf '  git config user.email "<handle>@users.noreply.github.com"\n' >&2
  exit 1
fi
